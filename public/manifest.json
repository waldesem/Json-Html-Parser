{
  "manifest_version": 3,
  "name": "Json-Html",
  "description": "Convert JSON to HTML",
  "version": "0.0.1",
  "host_permissions": ["file:///*"],
  "permissions": ["scripting", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Json-Html: Convert JSON to HTML"
  }
}
